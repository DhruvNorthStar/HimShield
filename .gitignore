# ---------------------------------------------------------------------------
# Data: large, binary and regenerable. Share it through the team drive, never git.
# The one exception is data/processed/*.csv (a few hundred KB, useful to share).
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/shapefiles/*
!data/shapefiles/.gitkeep
data/**/*.tif
data/**/*.tiff
data/**/*.hgt
data/**/*.zip
data/**/*.nc
data/**/*.grd
data/**/*.img
data/**/*.vrt
data/**/*.tif.vrt
# Derived vector layers from QGIS (buffers, clips, boundaries). Rebuilt from the guides, and some carry
# source licences (ODbL, CC BY-SA) that a public copy would have to honour. The QuickOSM extent
# rectangles live in a subfolder, which this pattern does not reach, so they stay tracked.
data/processed/*.gpkg
data/**/*.tfw
data/**/*.prj
data/**/*.qml
data/**/*.xml
*.aux.xml
*.ovr

# Models: binary, tens of MB, rebuilt by the training scripts
models/*
!models/.gitkeep
*.pkl
*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# QGIS backups and temp files
*.qgs~
*.qgz~
*.qgd

# Streamlit local secrets
.streamlit/secrets.toml

# IDEs (personal settings differ per teammate)
.idea/
.vscode/

# Windows / macOS clutter
Thumbs.db
desktop.ini
.DS_Store

# Step 9 web maps: rebuilt in about 20 s by `python -m src.demo_map`, and every run changes the
# embedded image, which would bloat the history. Force-add the final real-data map if it must be submitted.
outputs/demo_map_*.html

# Local Claude Code settings (preview launcher)
.claude/
